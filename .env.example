# OpenAQ API
OPENAQ_API_KEY=replace_with_your_openaq_api_key

# Required by the Airflow Docker Compose setup.
# On Linux, replace 50000 with the output of: id -u
AIRFLOW_UID=50000

# Used when running Python modules directly on the host.
DB_USER=sa
DB_PASSWORD=replace_with_your_local_database_password
DB_HOST=localhost
DB_PORT=1433
DB_NAME=master
DB_DRIVER=ODBC+Driver+18+for+SQL+Server
